.post-content figure.align-center {
    text-align: center;
}

.post-content figure > figcaption {
    color: var(--primary);
    font-size: 16px;
    font-weight: bold;
    margin: 2px 0 2px;
}

.post-content figure > figcaption > p {
    color: var(--secondary);
    font-size: 14px;
    font-weight: normal;
}*/

/* Bold numbers in the list */
.post-content ol li::marker {
  font-weight: bold;
}

/* Box for recipe with image and text */
.post-content div.recipe-header {
    display: inline-block;
    width: 100%;
}