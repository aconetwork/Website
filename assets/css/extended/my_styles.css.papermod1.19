/* themes/PaperMod/assets/css/core/theme-vars.css */
:root {/*
    --gap: 24px;
    --content-gap: 20px;*/
    --nav-width: 1110px;
    --main-width: 1000px;/*
    --header-height: 60px;
    --footer-height: 60px;
    --radius: 8px;
    --theme: rgb(255, 255, 255);
    --entry: rgb(255, 255, 255);
    --primary: rgb(30, 30, 30);
    --secondary: rgb(108, 108, 108);
    --tertiary: rgb(214, 214, 214);
    --content: rgb(31, 31, 31);*/
    --theme-header: rgb(245, 245, 245);
    --code-block-bg: rgb(221 245 217);
    --code-bg: rgb(245, 245, 245);
    --border: rgb(240, 240, 240);
    --border-figure: rgb(194, 152, 0);/*
    color-scheme: light;*/
    --details-title-bg-color: rgb(240, 240, 240);   /* Color for the collapsable element */
}

:root[data-theme="dark"] {
    --theme: rgb(29, 30, 32);
    --entry: rgb(46, 46, 51);
    --primary: rgb(218, 218, 219);
    --secondary: rgb(155, 156, 157);
    --tertiary: rgb(65, 66, 68);
    --content: rgb(196, 196, 197);
    --code-block-bg: rgb(46, 46, 51);
    --code-bg: rgb(55, 56, 62);
    --border: rgb(51, 51, 51);
    --border-figure: rgb(194, 152, 0);
    --theme-header: rgb(55, 56, 62);/*
    color-scheme: dark;*/
    --details-title-bg-color: rgb(55, 56, 62);   /* Color for the collapsable element */

    /* NOTICE mod for the dark theme */
    .notice {
        --title-color: #fff;
        --title-background-color: #069;
        --content-color: #ddd;
        --content-background-color: #023;
    }

    .notice.info {
        --title-background-color: #a50;
        --content-background-color: #420;
    }

    .notice.tip {
        --title-background-color: #363;
        --content-background-color: #121;
    }

    .notice.warning {
        --title-background-color: #800;
        --content-background-color: #400;
    }
}

/* Adding background color to header navigation */
.header {
    background-color: var(--theme-header);
}

/* Setting color for em : themes/PaperMod/assets/css/common/post-single.css */
.post-content em {
    color: var(--secondary);
}

.post-content pre code {
    /*display: grid;
    margin: auto 0;
    padding: 10px;*/
    color: var(--code-font-color) !important;/*
    background: var(--code-block-bg) !important;
    border-radius: var(--radius);
    overflow-x: auto;
    word-break: break-all;*/
}

/* Shift -2% logo instead -10% : /themes/PaperMod/assets/css/common/header.css */
.logo a img, .logo a svg {
    display: inline;
    vertical-align: middle;
    pointer-events: none;
    transform: translate(0,-2%);
    border-radius: 6px;
    margin-inline-end: 8px;
}

/* Shift -2% logo instead -10% : /home/aco/aconet-site/themes/PaperMod/assets/css/common/post-single.css */
.post-content img {
    display: inline-block;
    border-radius: 0px;
    margin: 0 0 0 0;
}

/* On tags page (terms.html) spacing along tags boxes */
.terms-tags li {
    /*display: inline-block;*/
    margin: 3px;
    /*font-weight: 500;*/
}

/* Removing box shadow fo fix black line on the bottom of images */
.post-content a, .toc a:hover {
    box-shadow: 0 0;
    /*box-decoration-break: clone;
    -webkit-box-decoration-break: clone;*/
}

/* Aligning text inside li for series */
.terms-tags li {
    /* margin: 3px; */
    text-align: center;
}

.post-content a {
    text-decoration: underline;
}

/* Collapsable */
.post-content details {
    border: 4px solid var(--details-title-bg-color);
    padding: 5px 5px 0 5px;
}

/* Collapsable summary */
.post-content details summary {
    background-color: var(--details-title-bg-color);
    padding: 5px;
    margin-bottom: 5px;
}

/* Table specs */
.post-content table th,
.post-content table:not(.highlighttable, .highlight table, .gist .highlight) td {
    min-width: 60px;/*
    padding: 8px 5px;
    line-height: 1.5;
    border-bottom: 1px solid var(--border);*/
}

/* Figure picture styles */
.post-content figure {
    padding: 4px;
    text-align: center; 
    border: 4px solid var(--border);
    display: inline-block; 
    margin: 1px 1px 21px 1px;
}

.post-content figure figcaption {
    color: var(--code-font-color);
    font-size: 16px;
    font-weight: bold;
    margin: 2px 0 2px;
    background-color: var(--border);
}

.post-content figure img {
  margin: 0 !important;
}

.post-content figure.float-right{
    float: right;
    margin-left: 25px;
}

.post-content figure.float-left{
    float: left;
    margin-right: 25px;
}

